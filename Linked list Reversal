1. Reverse Linked list {Type -> Easy}
Link: https://leetcode.com/problems/reverse-linked-list/
Code:
class Solution {
    public ListNode reverseList(ListNode head) {
        ListNode prev = null;
        ListNode curr = head;
        while (curr != null) {
            ListNode next = curr.next;
            curr.next = prev;
            prev = curr;
            curr = next;
        }
        return prev;
    }
}
