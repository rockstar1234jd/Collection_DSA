3. Java Switch Statement {type -> easy}
Link: https://www.geeksforgeeks.org/problems/java-switch-case-statement3529/1
Code:
class Solution {
    static double switchCase(int choice, List<Double> arr) {
        // code here
        switch(choice){
            case 1:
                double r = arr.get(0);
                return Math.PI*r*r;
            case 2:
                double l = arr.get(0);
                double b = arr.get(1);
                return l*b;
            default:
                System.out.print("Wrong output!!");
                return -1;
        }
    }
}

