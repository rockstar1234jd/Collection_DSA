14. Next prime number {Type -> Medium}
Link: https://www.geeksforgeeks.org/problems/next-prime-number
Code:
class Solution {
    public static int nextPrime(int n) {
        int num = n + 1;
        while (true) {
            if (isPrime(num)) {
                return num;
            }
            num++;
        }
    }
    public static boolean isPrime(int x) {
        if (x < 2) return false;
        if (x == 2) return true;
        if (x % 2 == 0) return false;
        for (int i = 3; i * i <= x; i += 2) {
            if (x % i == 0) {
                return false;
            }
        }
        return true;
    }
}

