import java.io.*;
import java.util.*;
public class Solution {
    static long[] bit;
    static void add(int i, long x) {
        for (; i < bit.length; i += i & -i)
            bit[i] += x;
    }
    static long sum(int i) {
        long res = 0;
        for (; i > 0; i -= i & -i)
            res += bit[i];
        return res;
    }
    static void rangeAdd(int l, int r, long x) {
        add(l + 1, x);
        add(r + 2, -x);
    }
    public static void main(String[] args) throws Exception {
        FastScanner fs = new FastScanner(System.in);
        int n = fs.nextInt();
        int m = fs.nextInt();
        Map<String, Integer> person = new HashMap<>(n * 2);
        for (int i = 0; i < n; i++)
            person.put(fs.next(), i);
        Map<String, Long> price = new HashMap<>(m * 2);
        for (int i = 0; i < m; i++)
            price.put(fs.next(), fs.nextLong());
        bit = new long[n + 2];
        long[] own = new long[n];
        int q = fs.nextInt();
        StringBuilder ans = new StringBuilder();
        while (q-- > 0) {
            int type = fs.nextInt();
            if (type == 1) {
                int p = person.get(fs.next());
                own[p] += price.get(fs.next());
            } 
            else if (type == 2) {
                int l = fs.nextInt();
                int r = fs.nextInt();
                long x = price.get(fs.next());
                if (l <= r) {
                    rangeAdd(l, r, x);
                } else {
                    rangeAdd(l, n - 1, x);
                    rangeAdd(0, r, x);
                }
            } 
            else {
                int p = person.get(fs.next());
                ans.append(own[p] + sum(p + 1)).append('\n');
            }
        }
        System.out.print(ans);
    }
    static class FastScanner {
        private final InputStream in;
        private final byte[] buffer = new byte[1 << 16];
        private int ptr = 0, len = 0;

        FastScanner(InputStream in) {
            this.in = in;
        }
        private int read() throws IOException {
            if (ptr >= len) {
                len = in.read(buffer);
                ptr = 0;
                if (len <= 0) return -1;
            }
            return buffer[ptr++];
        }
        String next() throws IOException {
            StringBuilder s = new StringBuilder();
            int c;
            while ((c = read()) <= ' ');
            while (c > ' ') {
                s.append((char)c);
                c = read();
            }
            return s.toString();
        }
        int nextInt() throws IOException {
            return Integer.parseInt(next());
        }
        long nextLong() throws IOException {
            return Long.parseLong(next());
        }
    }
}

