class Solution {
    public int partyHouse(ArrayList<ArrayList<Integer>> adj) {
        int n = adj.size();
                if (n == 1) return 0;
                // Convert to 0-indexed adjacency
                ArrayList<ArrayList<Integer>> g = new ArrayList<>();
                for (int i = 0; i < n; i++) {
                    ArrayList<Integer> list = new ArrayList<>();
                    for (int v : adj.get(i)) {
                        list.add(v - 1);
                    }
                    g.add(list);
                }
                // BFS from 0
                int[] dist = bfs(0, g, n);
                int u = 0;
                int max = -1;
                for (int i = 0; i < n; i++) {
                    if (dist[i] > max) {
                        max = dist[i];
                        u = i;
                    }
                }
                // BFS from u
                dist = bfs(u, g, n);
                int diameter = 0;
                for (int d : dist) {
                    if (d > diameter) diameter = d;
                }

                return (diameter + 1) / 2;
            }
            private int[] bfs(int start, ArrayList<ArrayList<Integer>> g, int n) {
                int[] dist = new int[n];
                Arrays.fill(dist, -1);
                Queue<Integer> q = new LinkedList<>();
                q.add(start);
                dist[start] = 0;
                while (!q.isEmpty()) {
                    int cur = q.poll();
                    for (int v : g.get(cur)) {
                        if (dist[v] == -1) {
                            dist[v] = dist[cur] + 1;
                            q.add(v);
                        }
                    }
                }
                return dist;
    }
}

