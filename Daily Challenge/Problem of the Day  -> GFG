class Solution {
    public int solve(int n, String s) {
        boolean[] seen = new boolean[26];
        boolean[] rejected = new boolean[26];

        int occupied = 0;
        int ans = 0;

        for (char c : s.toCharArray()) {
            int i = c - 'A';

            if (!seen[i]) {
                seen[i] = true;

                if (occupied < n) {
                    occupied++;
                } else {
                    rejected[i] = true;
                    ans++;
                }
            } else {
                if (!rejected[i]) {
                    occupied--;
                }
            }
        }

        return ans;
    }
}

