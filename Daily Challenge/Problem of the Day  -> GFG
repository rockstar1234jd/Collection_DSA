Code:
class Solution {
    public int countSubsequences(String s, int n) {
        final long MOD = 1_000_000_007L;

        long[] dp = new long[n];

        for (char ch : s.toCharArray()) {
            int d = ch - '0';

            // We need a separate array because every digit
            // can either be taken or not taken.
            long[] next = dp.clone();

            // Take this digit alone
            next[d % n]++;

            // Append this digit to every existing subsequence
            for (int r = 0; r < n; r++) {
                if (dp[r] == 0) {
                    continue;
                }

                int newRemainder = (r * 10 + d) % n;

                next[newRemainder] =
                    (next[newRemainder] + dp[r]) % MOD;
            }

            dp = next;
        }

        return (int) dp[0];
    }
}

