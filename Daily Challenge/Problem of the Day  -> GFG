12. Largest Rectangle with Column Swaps {Type -> Hard} 27-08-2026
Link: https://www.geeksforgeeks.org/problems/find-the-largest-rectangle-of-1s-with-swapping-of-columns-allowed0243/1
Code:
class Solution {
    public int maxArea(int[][] mat) {
        int n = mat.length;
        int m = mat[0].length;

        int[][] height = new int[n][m];

        // Build consecutive 1s height for every column
        for (int j = 0; j < m; j++) {
            height[0][j] = mat[0][j];

            for (int i = 1; i < n; i++) {
                if (mat[i][j] == 1) {
                    height[i][j] = height[i - 1][j] + 1;
                }
            }
        }

        int ans = 0;

        // Process every row
        for (int i = 0; i < n; i++) {

            // Counting sort
            int[] count = new int[n + 1];

            for (int j = 0; j < m; j++) {
                count[height[i][j]]++;
            }

            int col = 0;

            // Arrange heights in decreasing order
            for (int h = n; h >= 0; h--) {
                while (count[h] > 0) {
                    height[i][col++] = h;
                    count[h]--;
                }
            }

            // Calculate maximum rectangle
            for (int j = 0; j < m; j++) {
                int area = height[i][j] * (j + 1);
                ans = Math.max(ans, area);
            }
        }

        return ans;
    }
}

