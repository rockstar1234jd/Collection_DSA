Link: https://www.geeksforgeeks.org/problems/negative-weight-cycle3504/1
Code:
class Solution {
    public boolean isNegativeWeightCycle(int V, int[][] edges) {

        int[] dist = new int[V];

        // Initialize all vertices to 0 so that
        // negative cycles in disconnected components
        // are also detected.
        for (int i = 0; i < V; i++) {
            dist[i] = 0;
        }

        // Relax all edges V - 1 times
        for (int i = 0; i < V - 1; i++) {

            boolean changed = false;

            for (int[] edge : edges) {
                int u = edge[0];
                int v = edge[1];
                int w = edge[2];

                if (dist[u] + w < dist[v]) {
                    dist[v] = dist[u] + w;
                    changed = true;
                }
            }

            // No relaxation means no negative cycle
            if (!changed) {
                return false;
            }
        }

        // If we can still relax an edge,
        // a negative weight cycle exists.
        for (int[] edge : edges) {
            int u = edge[0];
            int v = edge[1];
            int w = edge[2];

            if (dist[u] + w < dist[v]) {
                return true;
            }
        }

        return false;
    }
}

