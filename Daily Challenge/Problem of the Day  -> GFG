class Solution {
    public String compress(String s) {
        int n = s.length();
        int[] lps = new int[n];

        // KMP LPS
        for (int i = 1; i < n; i++) {
            int j = lps[i - 1];
            while (j > 0 && s.charAt(i) != s.charAt(j))
                j = lps[j - 1];
            if (s.charAt(i) == s.charAt(j))
                j++;
            lps[i] = j;
        }
        StringBuilder ans = new StringBuilder();
        for (int i = n - 1; i >= 0; i--) {
            int len = i + 1;
            if (i % 2 == 1 &&
                lps[i] >= len / 2 &&
                len % (2 * (len - lps[i])) == 0) {
                ans.append('*');
                i = i / 2 + 1;
            } else {
                ans.append(s.charAt(i));
            }
        }
        return ans.reverse().toString();
    }
}

