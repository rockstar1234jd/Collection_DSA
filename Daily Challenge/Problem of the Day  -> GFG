           int query(int[] bit, int x) {
               int res = 0;
               while (x > 0) {
                   res = Math.max(res, bit[x]);
                   x -= x & -x;
               }
               return res;
           }
           void update(int[] bit, int x, int val) {
               while (x < bit.length) {
                   bit[x] = Math.max(bit[x], val);
                   x += x & -x;
               }
    }
