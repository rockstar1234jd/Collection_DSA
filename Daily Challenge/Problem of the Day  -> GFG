Link: https://www.geeksforgeeks.org/problems/find-marks-from-ranks/1
Code:
class Solution {
    public ArrayList<Integer> getMarks(int[] l, int[] r, int[] rank) {
        ArrayList<Integer> ans = new ArrayList<>();

        int n = l.length;

        // prefix[i] = total number of valid marks
        // from interval 0 to i
        long[] prefix = new long[n];

        for (int i = 0; i < n; i++) {
            long count = r[i] - l[i] + 1;

            prefix[i] = count;
            if (i > 0) {
                prefix[i] += prefix[i - 1];
            }
        }

        // Find answer for every rank
        for (int k : rank) {

            // Find first interval where prefix[i] >= k
            int low = 0;
            int high = n - 1;

            while (low < high) {
                int mid = low + (high - low) / 2;

                if (prefix[mid] >= k) {
                    high = mid;
                } else {
                    low = mid + 1;
                }
            }

            int i = low;

            // Number of marks before this interval
            long before = (i == 0) ? 0 : prefix[i - 1];

            // Position inside current interval
            long position = k - before;

            // Actual mark
            int mark = (int)(l[i] + position - 1);

            ans.add(mark);
        }

        return ans;
    }
}

