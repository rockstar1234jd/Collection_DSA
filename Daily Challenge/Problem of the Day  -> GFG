             int candidate = Integer.parseInt(sb.toString());
             int sum = digitSum(candidate);
             if (sum > bestSum || (sum == bestSum && candidate > best)) {
                 bestSum = sum;
                 best = candidate;
             }
         }
         return best;
     }
     private int digitSum(int n) {
         int sum = 0;

         while (n > 0) {
             sum += n % 10;
             n /= 10;
         }
         return sum;
    }
}

