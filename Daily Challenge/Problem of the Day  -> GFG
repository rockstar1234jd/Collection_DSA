                   while (j < n && a[j][0] == a[i][0]) j++;
                   int[] dp = new int[j - i];
                   for (int k = i; k < j; k++) {
                       dp[k - i] = query(bit, a[k][1] - 1) + a[k][1];
                       ans = Math.max(ans, dp[k - i]);
                   }
                   for (int k = i; k < j; k++)
                       update(bit, a[k][1], dp[k - i]);
                   i = j;
               }
               return ans;
