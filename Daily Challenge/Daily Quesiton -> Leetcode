1. Stone Game IX  {Type -> Medium}  Leetcode -> 2029
Link: https://leetcode.com/problems/stone-game-ix
Code:
class Solution {
    public boolean stoneGameIX(int[] stones) {
        int[] count = new int[3];
        for (int stone : stones) {
            count[stone % 3]++;
        }
        if (count[0] % 2 == 0) {
            return Math.min(count[1], count[2]) > 0;
        }
        return Math.abs(count[1] - count[2]) > 2;
    }
}

