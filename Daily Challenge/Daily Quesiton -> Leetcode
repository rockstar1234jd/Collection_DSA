3. Find the Largest Almost Missing Integer {Type -> Easy} Leetcode -> 3471
Link: https://leetcode.com/problems/find-the-largest-almost-missing-integer
Code: 
class Solution {
    public int largestInteger(int[] nums, int k) {
        int n = nums.length;
        int[] count = new int[51];
        for (int i = 0; i <= n - k; i++) {
            boolean[] seen = new boolean[51];
            for (int j = i; j < i + k; j++) {
                seen[nums[j]] = true;
            }
            for (int x = 0; x <= 50; x++)
                if (seen[x])
                    count[x]++;
        }
        for (int x = 50; x >= 0; x--)
            if (count[x] == 1)
                return x;
        return -1;
    }
}

