8. Sum Game {Type -> Medium} leetcode -> 1927
Link: https://leetcode.com/problems/sum-game
Code:
class Solution {
    public boolean sumGame(String num) {
        int n = num.length();
        int sumLeft = 0, sumRight = 0;
        int qLeft = 0, qRight = 0;
        // Left half
        for (int i = 0; i < n / 2; i++) {
            if (num.charAt(i) == '?') {
                qLeft++;
            } else {
                sumLeft += num.charAt(i) - '0';
            }
        }
        // Right half
        for (int i = n / 2; i < n; i++) {
            if (num.charAt(i) == '?') {
                qRight++;
            } else {
                sumRight += num.charAt(i) - '0';
            }
        }
        // Odd number of '?' => Alice wins
        if ((qLeft + qRight) % 2 == 1) {
            return true;
        }
        // Bob wins only if the sums can be perfectly balanced
        return sumLeft - sumRight != 9 * (qRight - qLeft) / 2;
    }
}


