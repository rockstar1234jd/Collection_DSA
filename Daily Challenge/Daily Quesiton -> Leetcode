11. Shortest and Lexicographically Smallest Beautiful String {Type -> Medium} Leetcode -> 2904
Link: https://leetcode.com/problems/shortest-and-lexicographically-smallest-beautiful-string
Code:
class Solution {
    public String shortestBeautifulSubstring(String s, int k) {
        int left = 0;
        int ones = 0;
        String answer = "";

        for (int right = 0; right < s.length(); right++) {
            if (s.charAt(right) == '1') {
                ones++;
            }

            // We have exactly k ones
            if (ones == k) {
                // Remove leading zeros
                while (left <= right && s.charAt(left) == '0') {
                    left++;
                }

                String current = s.substring(left, right + 1);

                if (answer.equals("") ||
                    current.length() < answer.length() ||
                    (current.length() == answer.length() &&
                     current.compareTo(answer) < 0)) {
                    answer = current;
                }

                // Move past the first 1
                left++;
                ones--;
            }
        }

        return answer;
    }
}

