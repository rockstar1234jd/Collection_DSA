5.Meeting Room II {Type -> Medium}
Link: https://www.geeksforgeeks.org/problems/attend-all-meetings-ii/1
Code:
class Solution {
    public int minMeetingRooms(int[] start, int[] end) {
        // code here
        Arrays.sort(start);
        Arrays.sort(end);
        int n = start.length;
        int rooms = 0;
        int maxRooms = 0;
        int i = 0, j = 0;

        while (i < n) {
            if (start[i] < end[j]) {
                rooms++;
                maxRooms = Math.max(maxRooms, rooms);
                i++;
            } else {
                rooms--;
                j++;
            }
        }
        return maxRooms;
    }
}

